{
  "name": "sobaka-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "test:run": "node --import tsx --test",
    "test": "glob -c \"npm run test:run -- --watch\" src/*.test.ts src/**/*.test.ts",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@sobaka/state": "*",
    "@sobaka/dsp": "*",
    "@sobaka/ui": "*",
    "@datastructures-js/priority-queue": "^6.3.2",
    "@syncedstore/svelte": "^0.6.0",
    "@tailwindcss/vite": "^4.1.7",
    "date-fns": "^2.29.2",
    "svelte-boring-avatars": "^1.2.2",
    "webmidi": "^3.0.21"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.3",
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/lodash": "^4.14.178",
    "@types/node": "^22.10.5",
    "@types/webmidi": "^2.0.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.36.0",
    "glob": "^11.0.1",
    "globals": "^15.0.0",
    "prettier": "^3.3.2",
    "prettier-plugin-svelte": "^3.2.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.1.7",
    "tslib": "^2.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.11"
  }
}
