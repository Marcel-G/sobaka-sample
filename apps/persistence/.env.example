# Sobaka Persistence Worker - Development Configuration
#
# Copy this file to .env and customize as needed:
#   cp .env.example .env
#
# Or use the dev script which handles JWT generation automatically:
#   ./scripts/dev.sh

# Signaling server URL
SIGNAL_SERVER=ws://localhost:8000/signaling

# Worker JWT token (required for worker identity)
# Generate with: cd ../signaling && JWT_PRIVATE_KEY=dev-secret cargo run --bin generate-jwt -- --worker
# JWT=<paste-generated-token-here>

# UDP port for WebRTC traffic
PORT=3478

# Public IP for WebRTC (leave unset for auto-detection in development)
# PUBLIC_IP=192.168.1.100

# Logging configuration
# Options: error, warn, info, debug, trace
# Module-specific: RUST_LOG=info,sobaka_client=debug
RUST_LOG=info,sobaka_client=debug

# Log format: 'json' for production log aggregation, unset for pretty console output
# LOG_FORMAT=json
