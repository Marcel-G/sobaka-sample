{
  "author": "Marcel Gleeson <gleeson.marcel@gmail.com>",
  "name": "sobaka-sample",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "package": "svelte-kit package",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check --plugin-search-dir=. . && eslint .",
    "format": "prettier --write --plugin-search-dir=. .",
    "prebuild": "cd ../sobaka-dsp && npm run build",
    "postinstall": "cd ../sobaka-dsp && npm install",
    "postci": "cd ../sobaka-dsp && npm ci",
    "postlint": "cd ../sobaka-dsp && npm run lint",
    "prelint": "npm run format"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.3",
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/lodash": "^4.14.178",
    "@types/webmidi": "^2.0.6",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.36.0",
    "globals": "^15.0.0",
    "postcss-color-function": "^4.1.0",
    "prettier": "^3.3.2",
    "prettier-plugin-svelte": "^3.2.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.3.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@syncedstore/core": "^0.6.0",
    "@syncedstore/svelte": "^0.6.0",
    "date-fns": "^2.29.2",
    "lodash": "^4.17.21",
    "ress": "^4.0.0",
    "sobaka-dsp": "file:../sobaka-dsp",
    "svelte-boring-avatars": "^1.2.2",
    "webmidi": "^3.0.21",
    "y-indexeddb": "^9.0.9",
    "y-webrtc": "^10.2.4",
    "yjs": "^13.5.48"
  }
}
