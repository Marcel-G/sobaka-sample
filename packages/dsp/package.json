{
  "name": "@sobaka/dsp",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wasm": {
      "types": "./pkg/sobaka_dsp.d.ts",
      "default": "./pkg/sobaka_dsp.js"
    }
  },
  "files": [
    "dist",
    "pkg"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir pkg",
    "build:wasm:debug": "wasm-pack build --debug --target web --out-dir pkg",
    "build:ts": "tsc",
    "build": "npm run build:wasm && npm run build:ts",
    "dev:wasm": "wasm-pack build --debug --target web --out-dir pkg -- --watch",
    "dev:ts": "tsc --watch",
    "dev": "npm run build:wasm:debug && npm run dev:ts",
    "clean": "rm -rf dist pkg target",
    "test:rust": "cargo test"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
