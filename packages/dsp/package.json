{
  "name": "@sobaka/dsp",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./wasm": {
      "types": "./pkg/sobaka_dsp.d.ts",
      "default": "./pkg/sobaka_dsp.js"
    }
  },
  "files": [
    "src",
    "pkg"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir pkg",
    "build:wasm:debug": "wasm-pack build --debug --target web --out-dir pkg",
    "build:wasm:debug-audio": "wasm-pack build --target web --out-dir pkg -- --features debug-audio",
    "build": "npm run build:wasm",
    "dev": "wasm-pack build --debug --target web --out-dir pkg -- --watch",
    "dev:debug-audio": "wasm-pack build --debug --target web --out-dir pkg -- --watch --features debug-audio",
    "check": "tsc --noEmit",
    "clean": "rm -rf pkg target",
    "test:rust": "cargo test"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
